{
  "name": "inaayah-launcher",
  "version": "0.2.3",
  "description": "Official Steam-style Desktop Game Launcher & Auto-Updater for Inaayah Studio Games",
  "main": "dist-electron/main.js",
  "author": "Inaayah Games",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --platform=node --format=cjs --bundle --external:electron --external:adm-zip --external:electron-updater",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build:electron && electron .",
    "dist": "npm run build && electron-builder",
    "deploy:worker": "./scripts/deploy-release-worker.sh",
    "lint": "tsc --noEmit",
    "release": "node scripts/release.js patch",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.inaayah.launcher",
    "productName": "Inaayah Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "inaayah",
        "repo": "inaayah-launcher"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game"
    }
  }
}
